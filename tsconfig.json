{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/vite-env.d.ts",
    "src/App.tsx",
    "src/main.tsx",
    "src/components/**/*",
    "src/context/**/*",
    "src/data/**/*",
    "src/firebase/**/*",
    "src/pages/**/*",
    "src/types/**/*"
  ]
}
